CREATE TABLE Position (
    id INTEGER PRIMARY KEY,
    account_id INTEGER REFERENCES Account(id),
    symbol TEXT,
    units REAL
);

selectAll:
SELECT * FROM Position;

selectByAccount:
SELECT * FROM Position WHERE account_id = ? ORDER BY symbol ASC;

selectByAccountAndSymbol:
SELECT * FROM Position WHERE account_id = ? AND symbol = ?;

insert:
INSERT INTO Position (account_id, symbol, units)
VALUES (?, ?, ?);

updateUnits:
UPDATE Position SET units = ? WHERE account_id = ? AND symbol = ?;

deleteByAccountAndSymbol:
DELETE FROM Position WHERE account_id = ? AND symbol = ?;
