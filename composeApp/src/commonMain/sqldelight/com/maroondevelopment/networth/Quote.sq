CREATE TABLE quote (
    symbol TEXT NOT NULL PRIMARY KEY,
    price REAL NOT NULL,
    change REAL NOT NULL
);

insertOrReplace:
INSERT OR REPLACE INTO quote (symbol, price, change)
VALUES (?, ?, ?);

selectAll:
SELECT * FROM quote;

selectBySymbol:
SELECT * FROM quote WHERE symbol = ?;

deleteBySymbol:
DELETE FROM quote WHERE symbol = ?;
